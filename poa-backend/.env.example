# POA Backend 环境变量
# 复制此文件为 .env 并填入实际值（.env 不会被提交到 git）

# 豆包 API（必填）
DOUBAO_API_KEY=ark-your-api-key-here
DOUBAO_MODEL_ID=doubao-seed-2-0-mini-260428
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# Ark SDK（可选，默认复用 DOUBAO_API_KEY）
ARK_API_KEY=
ARK_MODEL_ID=doubao-1.5-vision-pro-32k

# 数据库（可选，默认 SQLite）
# Railway 上由平台自动注入 DATABASE_URL（postgres:// 前缀会自动转换为 postgresql://）
# 本地也可使用 PostgreSQL: postgresql://user:pass@host:5432/dbname
DATABASE_URL=

# 上传文件目录（可选）
# 本地默认: uploads/
# Railway: 自动检测 /data 目录
UPLOAD_DIR=

# 服务端口（Railway 自动注入 $PORT）
PORT=8000

# 后端公网地址（Railway 部署时必填，火山 ASR/TTS 需通过公网下载音频）
# 示例: https://poa-backend-production-c371.up.railway.app
BACKEND_PUBLIC_URL=

# 豆包 TTS 语音合成（可选）
# 两种鉴权方式二选一：
#   方式A（推荐）：直接复用上方 DOUBAO_API_KEY，代码自动尝试 X-Api-Key 模式
#   方式B（Legacy）：在火山引擎控制台「语音技术」获取 APP_ID + Token
# DOUBAO_TTS_APP_ID=
# DOUBAO_TTS_TOKEN=
# DOUBAO_TTS_VOICE=en_female_dacey_uranus_bigtts
# DOUBAO_TTS_RESOURCE_ID=seed-tts-2.0

# ASR 流式语音转写（火山引擎 WebSocket 实时识别，推荐）
# 鉴权：优先 DOUBAO_ASR_API_KEY（新版控制台），回退 APP_ID + TOKEN
DOUBAO_ASR_API_KEY=
# DOUBAO_ASR_APP_ID=
# DOUBAO_ASR_TOKEN=
# 流式模型 resource_id（需带计费后缀）: volc.bigasr.sauc.duration(1.0小时版) / volc.bigasr.sauc.concurrent(1.0并发版)
# 2.0 版为 volc.seedasr.sauc.duration，需先在火山控制台开通（实测当前账号未开通）
DOUBAO_ASR_STREAM_RESOURCE_ID=volc.bigasr.sauc.duration
# 流式 ASR WebSocket 地址
DOUBAO_ASR_STREAM_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel
# 流式 ASR 超时（秒）
DOUBAO_ASR_STREAM_TIMEOUT=60
